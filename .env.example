# Copy to .env, then replace both secrets with different random values.
FERRY_API_TOKEN=replace-with-a-long-random-api-token
FERRY_API_SIGNING_KEY=replace-with-a-different-long-random-signing-key
FERRY_API_WORKERS=2
FERRY_API_FILE_URL_TTL=900
# Hours after a job finishes before its file and job record are deleted.
FERRY_API_FILE_RETENTION_HOURS=24
# Optional rotating proxy pool. When set, CDN file downloads egress through it;
# the browser stays direct unless proxy_pool_browser is enabled. Leave empty to
# keep the built-in auto-detection / direct routing.
FERRY_PROXY_POOL_URL=
