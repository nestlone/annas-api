# Copy to .env, then replace both secrets with different random values.
FERRY_API_TOKEN=replace-with-a-long-random-api-token
FERRY_API_SIGNING_KEY=replace-with-a-different-long-random-signing-key
FERRY_API_WORKERS=2
FERRY_API_FILE_URL_TTL=900
# Hours after a job finishes before its file and job record are deleted.
FERRY_API_FILE_RETENTION_HOURS=24
# Public base URL used to build status_url and download_url. Set it when the
# service runs behind a reverse proxy that does not forward the original Host
# header; otherwise those links carry the internal upstream address.
FERRY_API_PUBLIC_BASE_URL=
# Web console administrator, created on first start. Leave the password empty to
# instead let the first account that registers become the administrator.
FERRY_ADMIN_USERNAME=admin
FERRY_ADMIN_PASSWORD=
# Whether the console offers open registration; the administrator can change it
# from the console afterwards.
FERRY_REGISTRATION_OPEN=0
# Console session lifetime in hours.
FERRY_SESSION_TTL_HOURS=168
# Optional rotating proxy pool. When set, CDN file downloads egress through it;
# the browser stays direct unless proxy_pool_browser is enabled. Leave empty to
# keep the built-in auto-detection / direct routing.
FERRY_PROXY_POOL_URL=
